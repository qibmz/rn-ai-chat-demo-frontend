# Product display name (align with backend APP_NAME)
EXPO_PUBLIC_APP_NAME=牛马

# Backend Nest API (no trailing slash)
# Web: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: http://<your-lan-ip>:3000
# Android 真机/模拟器用 http 时，app.json → android.usesCleartextTraffic 须为 true（改完要重打 development build）
EXPO_PUBLIC_API_URL=http://localhost:3000

# AI SDK 聊天流式端点（默认 ${EXPO_PUBLIC_API_URL}/api/chat）
# EXPO_PUBLIC_CHAT_API_URL=http://localhost:3000/api/chat

# 聊天演示模式：默认开启本地 mock 流式；后端 AI SDK 就绪后设为 0
# EXPO_PUBLIC_CHAT_MOCK=0
